# =============================================================================
# VRAV Tube Engine — Environment Example
# Copy to .env and fill real values. NEVER commit real secrets.
# =============================================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://vrav:vrav@postgres:5432/vrav_tube
DATABASE_URL_SYNC=postgresql://vrav:vrav@postgres:5432/vrav_tube

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME=argon2

# AI — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=

# AI — RouterAI (https://routerai.ru) — primary for RU market
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_DEFAULT_MODEL=

# AI — xAI / Grok (optional)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# AI defaults
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3

# YouTube (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=usd

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads
# S3 (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Media processing limits
FFMPEG_MAX_DURATION_SECONDS=3600
FFMPEG_MAX_RESOLUTION=1920
FFMPEG_SAMPLE_FPS=0.5
FFMPEG_TIMEOUT_SECONDS=300

# Licensing
LICENSE_PUBLIC_KEY_PATH=/secrets/license_public.pem
# Online license service URL (optional)
LICENSE_VALIDATION_URL=

# Docker Compose production (docker-compose.prod.yml)
POSTGRES_USER=vrav
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vrav_tube
